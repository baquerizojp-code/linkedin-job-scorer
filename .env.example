# Copy this file to .env and fill in your values.
# The setup wizard (python3 setup.py) does this for you interactively.

# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# The Google Sheet that scored jobs are written to.
# Create a sheet with header row: Date | Company | Role | Location | Link | Fit Score | Match Summary | Red Flags | Recommend | Status
# The ID is the long string in the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# The Gmail label applied to your LinkedIn job alert emails.
# Create a Gmail filter (e.g. from:jobalerts-noreply@linkedin.com) that applies this label.
GMAIL_LABEL=LinkedIn Jobs

# Paths to your Google OAuth credentials. The wizard creates these.
GOOGLE_CREDS_PATH=./credentials/google_oauth.json
GOOGLE_TOKEN_PATH=./credentials/token.json
